.DS_Store
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Generated platform folders — recreate with ./setup.sh
# (comment these out once you start editing native code)
/android/
/ios/
/linux/
/macos/
/windows/

# The web folder is generated too, with one exception: the push service
# worker is ours, and `flutter build web` copies whatever is in here into the
# build. Ignoring the folder wholesale meant the worker was never committed
# and the deployed site had no `push/sw.js` — notifications subscribed
# against a file that did not exist. The directory itself has to be listed as
# `/web/*` rather than `/web/`, because git will not look inside an ignored
# directory to find a negated path.
/web/*
!/web/push/
# The loading screen and the bootstrap that loads CanvasKit from this server.
# `flutter create` keeps files that already exist, so these win over its
# template.
!/web/index.html
!/web/flutter_bootstrap.js
